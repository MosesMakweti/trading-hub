# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.next-dev.log

# Local media storage (universal image system)
/uploads/

# Installed agent skills (npx skills)
/.agents/
/.claude/skills/
/skills-lock.json

# 16-bit 8K backdrop masters (~90MB each) — regenerate with `node scripts/generate-backdrop.mjs --master`
assets/backdrop-source/spotlight-*-master.png
