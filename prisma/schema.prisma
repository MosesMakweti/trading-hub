generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Auth.js (NextAuth v5) + PrismaAdapter schema. Model names (User, Account,
// Session, VerificationToken) are fixed by the adapter's internal client
// calls (`prisma.account`, etc.) and cannot be renamed. Our own domain
// trading-account model is named `TradingAccount` in a later phase, so there
// is no naming collision to work around.
model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts Account[]
  sessions Session[]

  tradingAccounts        TradingAccount[]
  dailyNotes             DailyNote[]
  tradingDays            TradingDay[]
  weeklyReviews          WeeklyReview[]
  trades                 Trade[]
  opportunities          TradeOpportunity[]
  strategies             Strategy[]
  routineSections        RoutineSection[]
  routineItems           RoutineItem[]
  strategySessions       StrategySession[]
  strategyChecklistItems StrategyChecklistItem[]
  mediaAssets            MediaAsset[]

  userPropFirms            UserPropFirm[]
  propFirmAccounts         PropFirmAccount[]
  tradeAccountExecutions   TradeAccountExecution[]
  tradePlanScreenshots     TradePlanScreenshot[]
  tradeActualPartialExits  TradeActualPartialExit[]
  performanceRiskSnapshots PerformanceRiskSnapshot[]

  propFirmImportBatches          PropFirmImportBatch[]
  propFirmImportMappingTemplates PropFirmImportMappingTemplate[]
}

// "The trading day" the user considers it, independent of instants — stored
// as a date-only column (no time/timezone) to avoid off-by-one bugs for
// users west of UTC. Independent of any trades logged that day.
model DailyNote {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime  @db.Date
  content   Json?
  deletedAt DateTime?

  @@unique([userId, date])
}

// TradeOS V2 — the day-centric backbone (one "session" record per trading day).
// It orchestrates the Today workflow (prep → plan → trade → review → analyze)
// without duplicating trade data: Trade Idea/Execution/Review live on Trade, and
// this day's trades/notes are linked by date. `status` drives archiving to the
// Journal (ARCHIVED = finalized). Fields for Morning Prep (P3) and Today's Plan
// (P4) are added additively in their phases; P2 establishes the framework only.
// No soft delete — a day is archived, never deleted.
enum TradingDayStatus {
  ACTIVE
  ARCHIVED
}

// TradeOS V2 · Edge Workspace (P10) — a guided weekly review. One record per
// user per ISO-ish week (keyed by the week's Monday, stored date-only). The
// week's metrics are derived read-only from analytics; only the reflection
// (Tiptap rich text) is persisted here. Additive; no soft delete.
model WeeklyReview {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  weekStart DateTime @db.Date

  wentWell      Json?
  toImprove     Json?
  focusNextWeek Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, weekStart])
}

model TradingDay {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date

  status          TradingDayStatus @default(ACTIVE)
  // Workflow milestone stamps owned by the day (trade/review steps are derived
  // from the day's Trades). Null = not yet completed.
  prepCompletedAt DateTime?
  planCompletedAt DateTime?
  analyzedAt      DateTime?
  archivedAt      DateTime?

  // Pre-Session Routine (refactor). An immutable per-day snapshot of the routine:
  // the frozen sections+items structure AND the trader's responses, written when
  // the day's routine is first started so template edits never alter history.
  // routineReadyAt is set by the "I am ready to trade" gate and drives prepCompletedAt.
  routineSnapshot Json?
  routineReadyAt  DateTime?

  // Today's Trading Plan (P4). Day intentions: higher-timeframe bias
  // (BULLISH/BEARISH/NEUTRAL) + 1–5 conviction, key levels / areas of interest
  // (Tiptap JSON), and the day's intended risk budget (% — defaults from the
  // plan's daily limit). (Watchlist focus was dropped with the global Asset list.)
  bias              String?
  conviction        Int?
  keyLevels         Json?
  riskBudgetPercent Decimal? @db.Decimal(6, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId, status])
}

enum AccountKind {
  PROP_FIRM
  PERSONAL_BROKERAGE
  // The permanent, undeletable, unrenamable master ledger. Exactly one per
  // user, lazily created (see accounts.service.ts). Every other account's
  // trade PnL is derived from this account's entered PnL, scaled by relative
  // risk% — see domain/performance/allocation.ts.
  PERFORMANCE
}

enum AccountStatus {
  ACTIVE
  PASSED
  FAILED
  SUSPENDED
  CLOSED
}

enum PropFirmPhase {
  PHASE_1
  PHASE_2
  MASTER
}

// One table for both prop-firm and personal-brokerage accounts (kind
// discriminator + kind-specific nullable columns) so a future Trade can
// allocate risk/PnL against either kind through a single clean FK, instead
// of a polymorphic two-FK join.
model TradingAccount {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      AccountKind
  name      String
  status    AccountStatus @default(ACTIVE)
  notes     String?
  createdAt DateTime      @default(now())
  deletedAt DateTime?

  // prop-firm-only
  propFirmName String?
  accountSize  Decimal?       @db.Decimal(14, 2)
  phase        PropFirmPhase?
  purchaseCost Decimal?       @db.Decimal(14, 2)
  totalPayouts Decimal?       @db.Decimal(14, 2)

  // personal-brokerage-only AND performance (its $100k baseline lives here too)
  brokerName       String?
  startingBalance  Decimal? @db.Decimal(14, 2)
  totalWithdrawals Decimal? @db.Decimal(14, 2)
  totalDeposits    Decimal? @db.Decimal(14, 2)

  // performance-only — the virtual benchmark account's own configuration.
  // Null on every other kind. defaultRiskPercent falls back to 1% (the
  // app's long-standing "1R = 1%" convention) when unset; maxRiskPercent is
  // an optional per-trade cap; compoundingEnabled decides whether the next
  // trade's risk amount is based on the latest settled balance (true) or
  // always the fixed startingBalance (false, spec §11); effectiveDate
  // records when this configuration took effect (informational).
  defaultRiskPercent Decimal?  @db.Decimal(6, 3)
  maxRiskPercent     Decimal?  @db.Decimal(6, 3)
  compoundingEnabled Boolean   @default(true)
  currency           String?
  effectiveDate      DateTime? @db.Date

  // currentBalance is intentionally not a column — it's always baseline
  // (accountSize for prop-firm, startingBalance for brokerage/performance)
  // plus the sum of this account's trade allocation PnLs, computed on read
  // in accounts.service.ts. Persisting it would risk drifting from the
  // trade history that's supposed to be its source of truth.
  allocations              TradeAccountAllocation[]
  // Prop Firms module (Phase 1) — the richer PropFirmAccount this row is
  // paired with, when one exists (new prop-firm accounts, or a legacy row
  // wrapped by ensureLegacyPropFirmsMigrated). Null for brokerage/performance.
  propFirmAccount          PropFirmAccount?
  // Performance benchmark only — one immutable risk snapshot per trade
  // (see PerformanceRiskSnapshot below).
  performanceRiskSnapshots PerformanceRiskSnapshot[]

  @@index([userId, kind, deletedAt])
}

// ── Performance Account automatic benchmark (spec: "Adjust the Performance
// Account so it functions as an automatic, virtual benchmark") ─────────────
// One row per Trade (tradeId is unique) for the TradingAccount(kind:
// PERFORMANCE). Two groups of fields:
//   - LOCKED at first actual entry, then immutable forever (balanceBefore,
//     riskPercent, riskAmount, actualEntry, direction, assetSymbol, currency,
//     lockedAt) — "the historical risk amount must not change merely because
//     the Performance Account balance changes later."
//   - RECALCULABLE outcome (initialStop/initialStopSource resolved once then
//     frozen; realizedR/performancePnl/settledAt/calculationVersion) — safe
//     to recompute in place when actual exit/partial-exit data changes after
//     settlement (calculationVersion increments each time), since this whole
//     row is itself the append-only-per-trade ledger effect: the @@unique on
//     tradeId is what makes settlement idempotent (never a second effect for
//     the same trade), and deleting the Trade cascades this row away, which
//     is the "reverse any posted ledger effect" behavior for a voided trade.
model PerformanceRiskSnapshot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tradeId String @unique
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  performanceAccountId String
  performanceAccount   TradingAccount @relation(fields: [performanceAccountId], references: [id])

  // The confirmed TradePlanVersion active when the risk was locked, if any —
  // informational provenance, never re-resolved later.
  planVersionId String?
  planVersion   TradePlanVersion? @relation(fields: [planVersionId], references: [id], onDelete: SetNull)

  // ── Locked at first actual entry — immutable ────────────────────────────
  balanceBefore Decimal   @db.Decimal(14, 2)
  riskPercent   Decimal   @db.Decimal(6, 3)
  riskAmount    Decimal   @db.Decimal(14, 2)
  currency      String
  actualEntry   Decimal   @db.Decimal(18, 8)
  direction     Direction
  assetSymbol   String
  lockedAt      DateTime  @default(now())

  // ── Resolved once (first time available), then frozen — spec §8: moving
  // the stop to break-even/trailing later must never redefine the original
  // 1R unit.
  initialStop       Decimal?           @db.Decimal(18, 8)
  initialStopSource InitialStopSource?

  // ── Recalculable outcome — only written once the canonical trade is
  // fully closed (spec §9: never a partial settlement while exposure
  // remains). Re-derived in place (never a fabricated second row) whenever
  // actual exit/partial-exit data changes after the fact.
  realizedR          Decimal?  @db.Decimal(8, 4)
  performancePnl     Decimal?  @db.Decimal(14, 2)
  settledAt          DateTime?
  calculationVersion Int       @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([performanceAccountId])
}

enum InitialStopSource {
  ACTUAL
  PLANNED
}

// Pre-Session Routine item type. Extensible: adding a future type (RATING,
// DROPDOWN, NUMBER, TIMER…) is a new enum value + a renderer + optional `config`
// on RoutineItem — no schema redesign, and per-day responses stay in the snapshot.
enum RoutineItemType {
  CHECKBOX
  SHORT_TEXT
  LONG_TEXT
}

// A titled group of routine items (e.g. "Personal Readiness"). The editable
// template; the trader adds/renames/reorders/collapses sections in Settings.
model RoutineSection {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  sortOrder Int       @default(0)
  collapsed Boolean   @default(false)
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  items RoutineItem[]

  @@index([userId, sortOrder])
}

// A single routine item within a section. `type` picks the renderer; `config`
// holds per-type settings for future types (rating scale, dropdown options…).
model RoutineItem {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  sectionId   String
  section     RoutineSection  @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  type        RoutineItemType @default(CHECKBOX)
  label       String
  config      Json?
  // Mandatory items GATE the day: Today's Plan (and the rest of the workflow) stays
  // locked until every mandatory item is complete. Optional items never block.
  isMandatory Boolean         @default(false)
  sortOrder   Int             @default(0)
  createdAt   DateTime        @default(now())
  deletedAt   DateTime?

  @@index([userId, sectionId, sortOrder])
}

// Custom entry model (e.g. "Liquidity Sweep", "SMT"). Selectable per trade later.
enum Direction {
  LONG
  SHORT
}

enum Bias {
  BULLISH
  BEARISH
}

enum RiskInputType {
  PERCENT
  AMOUNT
}

// Which kind of record a media attachment hangs off. Polymorphic on purpose:
// one media system serves every feature (Trade, Strategy, Entry Model, …) and new
// modules just add a value here — no per-feature image table. ownerId is the
// target row's id (validated + user-scoped in the media service, so there is no
// hard FK). Extend this enum as new surfaces gain attachments.
enum MediaOwnerType {
  TRADE
  DAILY_NOTE
  STRATEGY
  STRATEGY_ENTRY_MODEL
  STRATEGY_CHECKLIST_ITEM
  STRATEGY_FRAMEWORK_STEP
  ARSENAL_CONCEPT
  // Prop Firms module (see AccountMilestone) — certificates/evidence attached
  // to a milestone (payout proof, pass certificate, breach screenshot, …).
  PROP_FIRM_MILESTONE
}

model Trade {
  id                       String       @id @default(cuid())
  userId                   String
  user                     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeDate                DateTime     @db.Date
  executionMinutes         Int
  direction                Direction
  higherTimeframeBias      Bias
  biasConfidencePercent    Int
  // Nullable — no longer manually entered at trade creation. Derived and kept
  // in sync from the TradingView Trade Plan's confirmed weighted planned R
  // (savePlan in trade-plan.service.ts) once that plan is confirmed; null
  // until then ("not planned yet", never a misleading 0R placeholder).
  expectedRR               Decimal?     @db.Decimal(8, 2)
  actualRR                 Decimal?     @db.Decimal(8, 2)
  psychPreTradeMindset     String?
  psychPostTradeReflection String?
  psychLessonsLearned      String?
  psychWhatToWorkOn        String?
  // Trade Workspace case-file fields (Phase 2) — all nullable, edited inline
  // in the workspace sections; the /edit form leaves them untouched. Prices
  // use Decimal(18,8) for FX/crypto precision. wouldTakeAgain is tri-state
  // (null = not answered yet).
  plannedEntry             Decimal?     @db.Decimal(18, 8)
  plannedStopLoss          Decimal?     @db.Decimal(18, 8)
  plannedTarget            Decimal?     @db.Decimal(18, 8)
  // TradingView Screenshot Trade Plan — chart timeframe of the plan (e.g. "15m").
  // Sits alongside the plannedEntry/StopLoss/Target trio above; kept as a plain
  // string (not an enum) since TradingView's own timeframe labels vary by asset
  // class and the trader may type one recognition doesn't cover.
  timeframe                String?
  marketContext            String?
  areasOfInterest          String?
  reasonForTrade           String?
  actualEntry              Decimal?     @db.Decimal(18, 8)
  actualExit               Decimal?     @db.Decimal(18, 8)
  // The stop actually in place at execution, entered explicitly by the
  // trader — never inferred from actualExit (checkpoint 2 §4: "do not infer
  // an actual stop from the final exit unless the execution explicitly
  // confirms it was a stop-loss exit"). Null = not recorded, which the
  // comparison service must report as missing data, not guess at.
  actualStopLoss           Decimal?     @db.Decimal(18, 8)
  executionNotes           String?
  whatWentWell             String?
  whatWentWrong            String?
  whatSurprisedMe          String?
  wouldTakeAgain           Boolean?
  // Behavioral intent tag for the Counterfactual (Discrepancy Gap) engine. Null on
  // historical rows → the engine infers behavior from other signals. FOMO/REVENGE/
  // IMPULSE/BOREDOM mark a trade a disciplined process would not have taken.
  tradeIntent              TradeIntent?
  // Trade Timeline lifecycle stamps (Phase 3) — captured when the trade first
  // transitions into each state (see domain/trades/lifecycle.ts). createdAt is
  // "logged", the in-market "executed" moment is derived (tradeDate +
  // executionMinutes), and updatedAt is the last edit.
  closedAt                 DateTime?
  reviewedAt               DateTime?
  // Strategy Lab reference + historical snapshots (Phase 4). strategyId is a live
  // reference (SetNull on strategy delete so the trade survives); the *Snapshot
  // columns freeze the strategy's name/version and the entry-model names at save
  // time, so a completed trade always shows the strategy as it was when taken,
  // even after the strategy is versioned, renamed, or deleted.
  strategyId               String?
  strategy                 Strategy?    @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  strategyNameSnapshot     String?
  strategyVersionSnapshot  Int?
  // Phase 5 (polish extras). tradeNumber is a stable, per-user monotonic counter
  // (unlike the derived ordinal it never shifts when a trade is deleted). status
  // is the materialized lifecycle stage (derived from closedAt/reviewedAt, kept
  // in sync at write time for indexed filtering). adherence* hold the optional
  // strategy-adherence self-scoring: answers as a {key: bool} Json map, plus the
  // denormalized percent computed by the pure scorer.
  tradeNumber              Int?
  status                   TradeStatus  @default(OPEN)
  adherenceAnswers         Json?
  adherencePercent         Float?

  // Strategy = single source of truth (SOT refactor). assetSymbol is the market
  // (the global Asset FK was dropped in P9; backfilled from asset.symbol first).
  // strategyExecutionSnapshot freezes the strategy's EXPECTED sessions/confluences/
  // execution that day; selected* record what was actually present. *Percent are
  // denormalized adherence scores (selected/expected) for analytics — NOT predictions.
  assetSymbol               String
  strategyExecutionSnapshot Json?
  selectedSession           String?
  selectedConfluences       Json?
  selectedExecution         Json?
  // The one entry model this trade was taken on, by name, from the selected
  // strategy's own Entry Models (Strategy = SOT). Frozen at save time so the
  // record survives the strategy being edited/deleted. Null if none chosen.
  selectedEntryModel        String?
  confluencePercent         Float?
  executionPercent          Float?
  tradeQualityPercent       Float?

  // Weighted confluence scoring (frozen at save time; NOT a market prediction).
  // setupScore = completed confluence weight / total strategy confluence weight × 100;
  // setupRating is the A+/A/B/C/Low band; setupValid is false when a mandatory
  // confluence was missing ("Invalid Setup"); missingConfluences is the string[] of
  // expected-but-absent confluence names.
  setupScore         Float?
  setupRating        String?
  setupValid         Boolean?
  missingConfluences Json?

  // Trade Opportunity architecture: the valid setup this executed trade came from
  // (when logged via the opportunity flow). Optional — trades logged directly have
  // no opportunity. @unique enforces one executed trade per opportunity (no
  // double-counting). SetNull so deleting the opportunity never deletes the trade.
  opportunityId String?           @unique
  opportunity   TradeOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  allocations        TradeAccountAllocation[]
  propFirmExecutions TradeAccountExecution[]
  psychology         PsychologyQuestionnaireResponse?

  // TradingView Screenshot Trade Plan — one screenshot-derived plan per trade
  // (at most; a manually-planned trade has none), its live target list, and
  // the append-only history of confirmed-plan snapshots. See the model group
  // below Trade for the full doc comment on how these fit together.
  planScreenshot          TradePlanScreenshot?
  plannedTargets          PlannedTarget[]
  planVersions            TradePlanVersion[]
  actualPartialExits      TradeActualPartialExit[]
  performanceRiskSnapshot PerformanceRiskSnapshot?

  @@unique([userId, tradeNumber])
  @@index([userId, tradeDate])
  @@index([userId, status])
}

enum TradeStatus {
  OPEN
  CLOSED
  REVIEWED
}

// Behavioral intent behind an executed trade (Counterfactual engine). PLANNED is
// the disciplined default; the rest are process breaches of decreasing "should not
// have taken this" severity. Null = unspecified (historical / not tagged).
enum TradeIntent {
  PLANNED
  FOMO
  REVENGE
  BOREDOM
  IMPULSE
  MANUAL_OVERRIDE
}

// ── Trade Opportunity architecture ───────────────────────────────────────────
// A TradeOpportunity is a *valid strategy setup* that was spotted. It is the
// single parent that resolves into exactly ONE outcome:
//   • EXECUTED   → the trader took it (an executed Trade links back via Trade.opportunityId)
//   • MISSED     → the trader did NOT take a valid setup (miss reason + optional outcome)
//   • INVALIDATED→ the setup broke its own rules before triggering (not a real miss)
//   • EXPIRED    → the window passed with no trigger (not a real miss)
//   • PENDING    → still being monitored (no outcome yet)
// Only EXECUTED and MISSED (of a *valid* setup) feed the Discrepancy Gap. This is
// how "missed opportunity cost" is separated from "execution leakage" WITHOUT
// double-counting (one opportunity → one outcome). Historical trades logged before
// this system existed have NO opportunity — they stay pure executed trades.
enum OpportunityStatus {
  PENDING
  EXECUTED
  MISSED
  INVALIDATED
  EXPIRED
}

// Why a valid setup was NOT taken (MISSED only). Behavioral, feeds Psychology Lab.
enum MissReason {
  FEAR
  HESITATION
  FOMO_ELSEWHERE // was chasing / in another trade
  DISTRACTED
  MISSED_ALERT // wasn't watching / no alert
  LATE_CONFIRMATION // saw it too late to enter safely
  RISK_CONCERNS // deliberately stood aside on risk
  TECHNICAL_ISSUE // platform / connectivity
  RULE_UNCERTAINTY // unsure it qualified in the moment
  INTENTIONAL_SKIP // conscious, disciplined pass (not a lapse)
  OTHER
}

// What a MISSED valid setup would have done — TRADER-ENTERED, never auto-derived
// (TradeOS has no price feed). UNDETERMINED = market didn't give enough info; such
// misses are tracked for behavior but excluded from missed-opportunity R cost.
enum MissedOutcome {
  MISSED_WIN
  MISSED_LOSS
  MISSED_BREAKEVEN
  MISSED_UNDETERMINED
}

model TradeOpportunity {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // When the setup was spotted (the "trading day" it belongs to) + market context.
  spottedAt   DateTime  @db.Date
  assetSymbol String
  direction   Direction
  timeframe   String? // optional label (e.g. "5m", "1h")

  // Live strategy reference + frozen snapshot (mirrors Trade — survives strategy
  // edits/deletes). SetNull keeps the opportunity if the strategy is deleted.
  strategyId              String?
  strategy                Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  strategyNameSnapshot    String?
  strategyVersionSnapshot Int?

  // Validation — reuses the SAME setup-score model as Trade (domain/trades/setup-score).
  // setupValid is the "is this a real opportunity" gate; only valid ones affect the gap.
  // strategyExecutionSnapshot freezes the strategy's EXPECTED sessions/confluences/
  // execution (mirrors Trade) so chips resolve colors + the record survives edits.
  strategyExecutionSnapshot Json?
  selectedConfluences       Json? // present confluences at spot time
  selectedExecution         Json? // present execution confirmations
  missingConfluences        Json? // expected-but-absent (drives the Invalid Setup state)
  confluencePercent         Float?
  executionPercent          Float?
  setupScore                Float?
  setupRating               String?
  setupValid                Boolean? // false = INVALIDATED candidate; null = unscored

  // Planned trade (the intended idea), same precision as Trade's plan fields.
  plannedEntry    Decimal? @db.Decimal(18, 8)
  plannedStopLoss Decimal? @db.Decimal(18, 8)
  plannedTarget   Decimal? @db.Decimal(18, 8)
  plannedRR       Decimal? @db.Decimal(8, 2) // the intended R:R of the idea

  // The strategy's proven edge per trade, FROZEN at spot time (from
  // StrategyTradeManagement.expectedExpectancy). This is the "expected R" the
  // Execution/Opportunity engine benchmarks against — a missed valid setup forfeits
  // this full R; an executed one is scaled by execution quality.
  expectedExpectancyR Decimal? @db.Decimal(8, 2)

  status OpportunityStatus @default(PENDING)

  // MISSED-only fields (null otherwise).
  missReason      MissReason?
  missNote        String?
  missedOutcome   MissedOutcome? // trader-entered; UNDETERMINED excluded from R cost
  // Realized-if-taken R, TRADER-ENTERED (e.g. +3.0 for a missed win, −1.0 for a
  // missed loss). Null when UNDETERMINED. Used as the actual-forgone R.
  missedRealizedR Decimal?       @db.Decimal(8, 2)

  // The executed trade, when status = EXECUTED (reverse of Trade.opportunityId,
  // one-to-one). Null for every non-executed outcome.
  executedTrade Trade?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete (registered in server/db.ts)

  @@index([userId, spottedAt])
  @@index([userId, status])
  @@index([userId, strategyId])
}

enum Grade {
  A
  B
  C
  D
  F
}

// The 8 questions themselves are fixed in code (domain/psychology/questions.ts),
// not user-customizable, so only answers are persisted here. rawScore/
// psychologyPercent/grade are denormalized — computed once at write time by
// the pure scoring function — because analytics needs fast aggregation/
// sorting/filtering by score across many trades, and the algorithm is fixed
// and versioned, so recomputing from `answers` on every query would be pure
// waste. This is different from account ROI/net-profit (Phase 3), which are
// trivial arithmetic derived on read every time — psychology scoring is
// comparatively expensive/complex, which is what justifies persisting it.
model PsychologyQuestionnaireResponse {
  id                String   @id @default(cuid())
  tradeId           String   @unique
  trade             Trade    @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  answers           Json
  rawScore          Int
  psychologyPercent Float
  grade             Grade
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Per-account risk input and closing PnL for a trade that may span multiple
// accounts of different sizes. Exactly one allocation per trade belongs to
// the user's PERFORMANCE account (identified via `tradingAccount.kind`) and
// its closingPnlGross/closingPnlNet are the only ones directly entered by
// the trader; every other account's are auto-calculated at write time by
// scaling the Performance Account's PnL by relative risk% (see
// domain/performance/allocation.ts) — never entered manually.
model TradeAccountAllocation {
  id               String         @id @default(cuid())
  tradeId          String
  trade            Trade          @relation(fields: [tradeId], references: [id], onDelete: Cascade)
  tradingAccountId String
  tradingAccount   TradingAccount @relation(fields: [tradingAccountId], references: [id])
  riskInputType    RiskInputType
  riskValue        Decimal        @db.Decimal(14, 2)
  closingPnlGross  Decimal        @db.Decimal(14, 2)
  closingPnlNet    Decimal        @db.Decimal(14, 2)

  @@unique([tradeId, tradingAccountId])
}

// ── Prop Firms module (Phase 2: Trade Idea ↔ Account Execution) ─────────────
// The System-B analogue of TradeAccountAllocation above, but for
// PropFirmAccount instead of TradingAccount, and with genuinely independent
// per-account risk/planned/actual fields rather than one derived from a
// Performance Account. A Trade (the "Idea" — shared thesis/setup/planned
// entry-stop-target already on Trade) has zero, one, or many of these — one
// per PropFirmAccount it was allocated/executed on. Fully additive; nothing
// on Trade/TradeAccountAllocation/TradingAccount changes.
enum RiskEntryMode {
  PERCENT
  AMOUNT
  FIXED_SIZE
}

enum RiskBasis {
  CURRENT_BALANCE
  CURRENT_EQUITY
  STAGE_STARTING_BALANCE
}

// PLANNED = risk not yet confirmed. ALLOCATED = risk/account confirmed but
// not yet in the market. EXECUTED = position open. PARTIALLY_CLOSED = some
// size closed, some still open. CLOSED = fully settled (realized PnL final).
// CANCELLED/MISSED/NOT_TAKEN never affect the account's balance but stay
// visible for review (spec §3).
enum ExecutionStatus {
  PLANNED
  ALLOCATED
  EXECUTED
  PARTIALLY_CLOSED
  CLOSED
  CANCELLED
  MISSED
  NOT_TAKEN
}

model TradeAccountExecution {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  propFirmAccountId String
  propFirmAccount   PropFirmAccount @relation(fields: [propFirmAccountId], references: [id])

  // The account's active AccountStage at the moment this execution was taken.
  // A plain FK is sufficient as a "snapshot" — a stage's identity fields
  // (name/type/order) are set once at creation and its performance fields
  // only ever change once, atomically, when advanceAccountStage closes it —
  // so this FK never silently repoints under an old execution.
  accountStageId String
  accountStage   AccountStage @relation(fields: [accountStageId], references: [id])

  // ── Planned risk / sizing ──────────────────────────────────────────────
  riskEntryMode  RiskEntryMode
  riskBasis      RiskBasis
  riskInputValue Decimal       @db.Decimal(14, 4) // the raw %, $, or lot/contract count entered

  // The resolved risk base (account balance/equity/stage-starting balance,
  // per riskBasis) at the moment this allocation was FIRST confirmed. Frozen
  // — never recomputed on a later edit unless the trader explicitly changes
  // riskEntryMode/riskBasis/riskInputValue (see upsertExecutionWithinTx).
  // This is what makes plannedRiskAmount an immutable snapshot rather than a
  // value that silently drifts when the account's balance later moves from
  // unrelated trades (spec §1: "do not recalculate the original risk amount
  // from a future account balance").
  riskBaseSnapshot          Decimal  @db.Decimal(14, 2)
  plannedRiskAmount         Decimal  @db.Decimal(14, 2) // frozen at save: Base × %/100, or the $ entered
  plannedPositionSize       Decimal? @db.Decimal(14, 4) // lots/contracts — null when instrument data was insufficient (never guessed)
  positionSizeMissingReason String? // explains what's needed when plannedPositionSize is null

  // Nullable OVERRIDE of the Idea's plannedEntry/plannedStopLoss/plannedTarget
  // (on Trade). Null = inherit the idea's plan. A CFD execution and a futures
  // execution of the same idea can legitimately need different instrument
  // prices, without duplicating the shared analysis for the common case.
  plannedEntryOverride    Decimal? @db.Decimal(18, 8)
  plannedStopLossOverride Decimal? @db.Decimal(18, 8)
  plannedTargetOverride   Decimal? @db.Decimal(18, 8)
  plannedR                Decimal? @db.Decimal(8, 4) // frozen planned reward:risk from the resolved plan

  // ── Actuals ─────────────────────────────────────────────────────────────
  actualEntry       Decimal? @db.Decimal(18, 8)
  actualExit        Decimal? @db.Decimal(18, 8)
  actualLotSize     Decimal? @db.Decimal(14, 4)
  actualContractQty Decimal? @db.Decimal(14, 4)

  grossPnl       Decimal? @db.Decimal(14, 2)
  commission     Decimal? @db.Decimal(14, 2)
  swapFinancing  Decimal? @db.Decimal(14, 2)
  otherFees      Decimal? @db.Decimal(14, 2)
  netPnl         Decimal? @db.Decimal(14, 2) // Gross − Commission − Swap − OtherFees, or estimated (see isPnlEstimated)
  isPnlEstimated Boolean  @default(false) // true when netPnl was derived from actualR × plannedRiskAmount, not real PnL
  actualR        Decimal? @db.Decimal(8, 4) // netPnl / plannedRiskAmount

  status         ExecutionStatus @default(PLANNED)
  executionNotes String?

  plannedAt DateTime  @default(now())
  openedAt  DateTime?
  closedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  actualPartialExits TradeActualPartialExit[]

  @@unique([tradeId, propFirmAccountId])
  @@index([userId, propFirmAccountId, deletedAt])
  @@index([accountStageId])
  @@index([tradeId])
}

// ── Universal media system ───────────────────────────────────────────────────
// One user-owned asset per uploaded file (the file lives in UploadThing; we keep
// the metadata + storage key). Attachments (below) link an asset to any record,
// so a feature never needs its own image table.
model MediaAsset {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  storageKey String // UploadThing file key (for retrieval + deletion)
  fileName   String
  mimeType   String
  fileSize   Int // bytes
  url        String
  createdAt  DateTime @default(now())

  attachments MediaAttachment[]

  // TradingView Screenshot Trade Plan reuses this same asset table for its
  // original upload and (optional) annotated preview render — no parallel
  // file-storage system. Named relations since one screenshot can reference
  // two distinct assets. The original also gets a normal MediaAttachment
  // (TRADE, category "BEFORE") so it keeps appearing in the existing
  // Journal/Trades Album galleries exactly like any other before-trade image.
  planScreenshotOriginalOf TradePlanScreenshot? @relation("TradePlanScreenshotOriginal")
  planScreenshotPreviewOf  TradePlanScreenshot? @relation("TradePlanScreenshotPreview")

  @@index([userId, createdAt])
}

// Polymorphic link between an asset and the record it documents. Deleting the
// asset cascades its attachments; deleting an owner record is handled in app code
// (there is no hard FK, by design — see MediaOwnerType). An optional `category`
// buckets attachments within one owner (e.g. a trade's ANALYSIS/BEFORE/AFTER).
model MediaAttachment {
  id        String         @id @default(cuid())
  mediaId   String
  media     MediaAsset     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  ownerType MediaOwnerType
  ownerId   String
  category  String?
  caption   String?
  sortOrder Int            @default(0)
  createdAt DateTime       @default(now())

  @@index([ownerType, ownerId, sortOrder])
  @@index([mediaId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// STRATEGY LAB
//
// A trader's methodology workspace. `Strategy` is the hub; every workspace
// section (Arsenal / Framework / Timeframes / Entry Models / Trade Management)
// attaches to it by `strategyId` with `onDelete: Cascade`, so deleting or
// duplicating a strategy fans out to its whole tree in one operation.
//
// Built in phases — see docs/STRATEGY_LAB.md. Phase 1 ships the hub + settings;
// the commented relations below are the exact extension points for later phases.
// ─────────────────────────────────────────────────────────────────────────────

enum StrategyStatus {
  DRAFT
  TESTING
  LIVE
  ARCHIVED
}

// Shared tag palette (Notion-style) for colored chips across the app — confluences,
// execution confirmations, sessions, and future tag-based properties. Rendered by
// one Tag component so a color reads consistently everywhere.
enum TagColor {
  GRAY
  BLUE
  GREEN
  AMBER
  RED
  PURPLE
  YELLOW
  TEAL
}

enum StrategyChecklistKind {
  CONFLUENCE
  EXECUTION
}

// Direction applicability of a CONFLUENCE checklist item. BULLISH confluences are
// only eligible for LONG trades, BEARISH only for SHORT; BOTH covers
// direction-neutral conditions (session, volatility, key level, liquidity, news,
// general HTF context). Existing rows default to BOTH — direction is never
// guessed from a confluence's name.
enum ConfluenceDirection {
  BULLISH
  BEARISH
  BOTH
}

model Strategy {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String? // plain-text summary shown on the strategy card

  // Free-text market symbols (XAUUSD, NAS100, …). Stored as a scalar list for
  // simple tag-style editing; surfaced inside the Journal when the strategy is
  // selected (Journal integration — a later phase).
  applicableAssets String[]

  status StrategyStatus @default(DRAFT)

  // Versioning-ready: a future `StrategyVersion` model can snapshot the full
  // nested tree keyed by (strategyId, version); this counter is the anchor.
  version Int @default(1)

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete (registered in server/db.ts); Archive is a status, Delete sets this

  // ── Workspace sections ─────────────────────────────────────────────────────
  arsenalConcepts ArsenalConcept[] // Section 1 — Arsenal (expandable concept cards)
  frameworkSteps  StrategyFrameworkStep[] // Section 2 — Framework (ordered decision steps)
  timeframes      StrategyTimeframe[] // Section 3 — Timeframe workspace (each has checkpoints)
  entryModels     StrategyEntryModel[] // Section 4 — Entry Models
  tradeManagement StrategyTradeManagement? // Section 5 — Trade Management (1:1 + partial TPs, custom rules)
  sessions        StrategySession[] // Section — Trading Sessions (SOT refactor)
  checklistItems  StrategyChecklistItem[] // Sections — Confluences + Execution Confirmations (SOT)
  // Journal link: a trade references a strategy (not a copy). onDelete: SetNull
  // on the Trade side keeps completed trades (with their snapshots) intact.
  trades          Trade[]
  opportunities   TradeOpportunity[] // valid setups spotted under this strategy (executed or missed)
  versions        StrategyVersion[] // published, immutable snapshots of the tree

  @@index([userId, deletedAt, sortOrder])
}

// An immutable, published snapshot of a strategy's full tree at a point in time.
// Publishing snapshots the *current* version number then bumps Strategy.version,
// so the live strategy is always the highest (editable, unpublished) version and
// every past version is preserved. No soft delete — history is permanent. The
// snapshot is denormalized JSON (self-contained; survives edits/deletes to the
// live tree). `trade.strategyVersionSnapshot` ties a trade to the version it was
// taken under.
model StrategyVersion {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  version   Int
  note      String? // optional changelog note for this version
  snapshot  Json // the full strategy tree at publish time
  createdAt DateTime @default(now())

  @@unique([strategyId, version])
  @@index([strategyId, version])
}

// Strategy Lab · Section 1 — Arsenal. Each concept is an expandable card in the
// strategy workspace. All descriptive fields are Tiptap rich-text JSON (edited
// with RichTextEditor). Scoped to a user through its parent Strategy. Charts /
// image attachments are deferred app-wide (UploadThing) and will attach here.
model ArsenalConcept {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  name String

  definition    Json?
  purpose       Json?
  howIIdentify  Json?
  whyItMatters  Json?
  whenIUse      Json?
  whenIIgnore   Json?
  examples      Json?
  personalNotes Json?

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([strategyId, deletedAt, sortOrder])
}

// Strategy Lab · Section 2 — Framework. An ordered, drag-and-drop sequence of
// decision steps (e.g. Determine HTF bias → … → Manage position). Description
// and notes are Tiptap rich-text JSON. Scoped to a user via its parent Strategy.
model StrategyFrameworkStep {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  title       String
  description Json?
  notes       Json?

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([strategyId, deletedAt, sortOrder])
}

// Strategy Lab · Section 3 — Timeframe Workspace. Two levels: a strategy has
// unlimited timeframes (Monthly … M1), each holding unlimited checkpoints. Scoped
// to a user via Strategy; checkpoints via their timeframe's strategy.
model StrategyTimeframe {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  name String // e.g. Monthly, Weekly, Daily, H4, M15

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  checkpoints StrategyCheckpoint[]

  @@index([strategyId, deletedAt, sortOrder])
}

// A checkpoint within a timeframe (e.g. Daily → "Determine trend"). Description
// and notes are Tiptap rich-text JSON; images deferred (UploadThing).
model StrategyCheckpoint {
  id          String            @id @default(cuid())
  timeframeId String
  timeframe   StrategyTimeframe @relation(fields: [timeframeId], references: [id], onDelete: Cascade)

  title       String
  description Json?
  notes       Json?

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([timeframeId, deletedAt, sortOrder])
}

// Strategy Lab · Section 4 — Entry Models. A strategy may have several distinct
// entry models, each a documented setup. All descriptive fields are Tiptap
// rich-text JSON. Named StrategyEntryModel to avoid colliding with the Journal's
// EntryModel. Example images deferred (UploadThing). Scoped via parent Strategy.
model StrategyEntryModel {
  id         String   @id @default(cuid())
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  name String

  description           Json?
  conditions            Json?
  confirmationChecklist Json?
  invalidation          Json?
  stopPlacement         Json?
  targetLogic           Json?
  notes                 Json?

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([strategyId, deletedAt, sortOrder])
}

// Strategy Lab · Section 5 — Trade Management. One record per strategy (1:1),
// plus two child lists. Rule fields are Tiptap rich-text JSON; max-hold/risk are
// structured. Scoped to a user via the parent Strategy.
model StrategyTradeManagement {
  id         String   @id @default(cuid())
  strategyId String   @unique
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  takeProfitPhilosophy Json?
  initialStopPlacement Json?
  breakEvenRules       Json?
  trailingStopRules    Json?
  scalingInRules       Json?
  scalingOutRules      Json?

  maxHoldingTime String? // free text, e.g. "2 hours", "1 session"
  maxRiskPercent Decimal? @db.Decimal(6, 2)

  // Counterfactual engine limits (optional). A day whose realized risk exceeds
  // maxDailyRiskPercent, or whose trade count exceeds maxTradesPerDay, raises a
  // FLAGGED risk/behavioral breach on the offending trades (no fabricated R).
  maxDailyRiskPercent Float?
  maxTradesPerDay     Int?

  // Discrepancy-Gap benchmarks (D2): the strategy's PROVEN edge, used by the
  // Execution Engine as the "expected" baseline. expectedExpectancy (R per trade at
  // full execution) is the primary input to Expected R; the others describe the edge
  // and minExecutionScore is the quality bar below which a setup isn't A-grade.
  expectedWinRate    Float? // 0–100
  expectedAvgRr      Float? // avg winner R
  expectedExpectancy Float? // R per trade (benchmark for Expected Result)
  minExecutionScore  Int? // 0–100

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  partialTakeProfits PartialTakeProfit[]
  customRules        TradeManagementRule[]
}

// Strategy Lab — Confluences + Execution Confirmations (unified, kind-discriminated).
// Rich, colored tag objects owned by a strategy: a trade taken under the strategy
// picks from these, and adherence is scored against the enabled set. Replaces the
// global ChecklistItemDefinition(CONFLUENCE|EXECUTION) — dropped in P9.
model StrategyChecklistItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  kind               StrategyChecklistKind
  name               String
  color              TagColor              @default(GRAY)
  icon               String? // optional lucide icon name
  category           String?
  description        String?
  weight             Int? // probability weight (0-100) used by the weighted setup-scoring engine
  // CONFLUENCE only: which trade direction this confluence is eligible for.
  // Filters BEFORE scoring so bull-only weights never enter a long denominator
  // (and vice-versa). Always BOTH for EXECUTION items and for pre-existing rows.
  directionApplicability ConfluenceDirection @default(BOTH)
  // Optional organizational link between opposite versions of the same condition
  // (e.g. "Bullish MSB" / "Bearish MSB" share a pairId). Display-only — never a
  // substitute for `directionApplicability`, and pairing is not required.
  pairId                 String?
  // Confluence scoring (CONFLUENCE kind): mandatory items gate setup validity — a
  // setup missing any mandatory confluence is "Invalid Setup". Optional items only
  // add to the weighted probability score. validationCriteria is the objective test
  // for "is this confluence actually present?".
  mandatory          Boolean               @default(false)
  validationCriteria String?
  enabled            Boolean               @default(true)

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, strategyId, kind, sortOrder])
}

// Strategy Lab — Trading Sessions owned by a strategy (colored). Replaces the global
// TradingSession — dropped in P9.
model StrategySession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  strategyId String
  strategy   Strategy @relation(fields: [strategyId], references: [id], onDelete: Cascade)

  name         String
  color        TagColor @default(GRAY)
  startMinutes Int? // minutes-since-midnight, optional
  endMinutes   Int?
  enabled      Boolean  @default(true)

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([userId, strategyId, sortOrder])
}

// A partial take-profit level (unlimited per trade-management record).
model PartialTakeProfit {
  id                String                  @id @default(cuid())
  tradeManagementId String
  tradeManagement   StrategyTradeManagement @relation(fields: [tradeManagementId], references: [id], onDelete: Cascade)

  trigger        String? // e.g. "at 2R", "prior day high"
  percentToClose Decimal? @db.Decimal(5, 2)
  reason         String?

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tradeManagementId, deletedAt, sortOrder])
}

// A free-form custom management rule (unlimited).
model TradeManagementRule {
  id                String                  @id @default(cuid())
  tradeManagementId String
  tradeManagement   StrategyTradeManagement @relation(fields: [tradeManagementId], references: [id], onDelete: Cascade)

  text String

  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([tradeManagementId, deletedAt, sortOrder])
}

// ── Prop Firms module (Phase 1: foundation) ──────────────────────────────────
// Replaces the user-facing Accounts section for PROP_FIRM-kind accounts with a
// real hierarchy: directory -> UserPropFirm -> PropFirmAccount -> AccountStage
// -> StageRule, plus AccountMilestone (evidence) and Payout. Deliberately
// additive: `TradingAccount`/`TradeAccountAllocation` are UNTOUCHED and remain
// the trade-allocation FK target (createTrade, analytics, the Dashboard "Best
// Account" KPI, and CSV import-by-name all depend on them as-is). Each
// PropFirmAccount optionally pairs 1:1 with a TradingAccount row via
// `tradingAccountId` — new accounts get one created alongside them; existing
// PROP_FIRM TradingAccount rows are lazily wrapped into one by
// `ensureLegacyPropFirmsMigrated` (prop-firms-migration.service.ts) the first
// time a user opens /prop-firms, under a single custom "Migrated Accounts"
// UserPropFirm — no data is deleted, no manual script to remember to run.
//
// "Current stage" is intentionally NOT a stored pointer (no
// PropFirmAccount.currentStageId): mirrors this schema's own convention that
// TradingAccount.currentBalance is never stored either, always computed. The
// current stage is whichever AccountStage for the account has status PENDING
// or ACTIVE — enforced by application logic (advancing a stage always closes
// the previous one first, in one transaction; see advanceAccountStage).
//
// Live rule evaluation, trade allocation to a specific stage, and a full
// stage/rule/milestone/payout management UI are explicitly OUT of scope here
// — StageRule.evaluationMetadata is reserved Json for that later phase.

enum MarketCategory {
  CFD
  FUTURES
}

// Global, admin-curated catalog (seeded — see src/data/prop-firm-directory.ts).
// Identity/branding only: it must never be read as "these are this firm's
// current rules" — rules live per-stage, entered by the trader.
model PropFirmDirectoryEntry {
  id             String           @id @default(cuid())
  companyName    String
  slug           String           @unique
  logoUrl        String?
  markets        MarketCategory[] // CFD, FUTURES, or both
  website        String?
  accentColor    String?
  isActive       Boolean          @default(true)
  sortOrder      Int              @default(0)
  lastVerifiedAt DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  userFirms UserPropFirm[]

  @@index([isActive, sortOrder])
}

enum PropFirmIdentityKind {
  DIRECTORY
  CUSTOM
}

enum UserPropFirmStatus {
  ACTIVE
  ARCHIVED
}

// A trader's relationship to one company (directory-backed or custom-entered),
// scoped to one market category. Priority is NOT exclusive — multiple firms
// can be `isPriority` at once; `priorityOrder` is the trader's own ranking
// among those (nulls last / unordered when not a priority).
model UserPropFirm {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  identityKind     PropFirmIdentityKind
  directoryEntryId String?
  directoryEntry   PropFirmDirectoryEntry? @relation(fields: [directoryEntryId], references: [id])

  // Custom-firm identity (identityKind = CUSTOM only).
  customCompanyName String?
  customLogoUrl     String?
  customWebsite     String?
  customAccentColor String?

  marketCategory MarketCategory
  isPriority     Boolean            @default(false)
  priorityOrder  Int?
  status         UserPropFirmStatus @default(ACTIVE)
  notes          String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts PropFirmAccount[]

  @@index([userId, status, deletedAt])
  @@index([userId, isPriority, priorityOrder])
}

enum PropFirmAccountModelType {
  ONE_PHASE
  TWO_PHASE
  THREE_PHASE
  INSTANT_FUNDED
  CUSTOM
}

enum PropFirmAccountStatus {
  ACTIVE
  PASSED
  FAILED
  BREACHED
  FUNDED
  ARCHIVED
}

// A single purchased account under a UserPropFirm. `tradingAccountId` is the
// paired ledger row trades actually allocate against (unchanged mechanism);
// everything else here is the rich metadata TradingAccount has no room for.
// `externalRef` is a broker/account NUMBER for reference only — never a
// password or credential (enforced by convention + validation, not schema).
model PropFirmAccount {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  userPropFirmId String
  userPropFirm   UserPropFirm @relation(fields: [userPropFirmId], references: [id], onDelete: Cascade)

  tradingAccountId String?         @unique
  tradingAccount   TradingAccount? @relation(fields: [tradingAccountId], references: [id])

  displayName    String
  externalRef    String?
  marketCategory MarketCategory
  modelName      String?
  modelType      PropFirmAccountModelType

  accountSize     Decimal @db.Decimal(14, 2)
  accountCurrency String  @default("USD")

  purchasePrice  Decimal?  @db.Decimal(14, 2)
  discount       Decimal?  @db.Decimal(14, 2)
  resetFees      Decimal?  @db.Decimal(14, 2)
  activationFees Decimal?  @db.Decimal(14, 2)
  otherCosts     Decimal?  @db.Decimal(14, 2)
  purchaseDate   DateTime? @db.Date

  status PropFirmAccountStatus @default(ACTIVE)

  // Manual snapshots for now (Phase 1) — not yet computed from stage
  // executions, which needs the trade-allocation work deferred to a later
  // phase. startingBalance is the account's opening balance (usually ==
  // accountSize, kept separate since resets can change it without changing
  // the purchased size).
  startingBalance Decimal  @db.Decimal(14, 2)
  currentBalance  Decimal? @db.Decimal(14, 2)
  currentEquity   Decimal? @db.Decimal(14, 2)

  archivedAt DateTime?
  notes      String?

  // Daily-loss / consistency reset boundary (spec §7) — one boundary per
  // account, shared by every daily-scoped rule on its stages (a property of
  // the funding firm's rules, not of an individual rule row). Null timezone
  // = UTC; dailyResetHour is the local hour (0-23) the trading day resets.
  dailyResetTimezone String?
  dailyResetHour     Int?    @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  stages        AccountStage[]
  milestones    AccountMilestone[]
  payouts       Payout[]
  executions    TradeAccountExecution[]
  ledgerEntries AccountLedgerEntry[]

  // CSV import (§ Prop Firm CSV Import) — entirely separate from `executions`
  // (real Journal-linked TradeAccountExecution rows) and never touches Trade.
  importBatches        PropFirmImportBatch[]
  importedExecutions   PropFirmImportedExecution[]
  importedTrades       PropFirmImportedTrade[]
  importedTransactions PropFirmTransaction[]

  @@index([userId, status, deletedAt])
  @@index([userPropFirmId])
}

enum AccountStageType {
  PHASE_1
  PHASE_2
  PHASE_3
  VERIFICATION
  MASTER_FUNDED
  PAYOUT_ELIGIBLE
  CUSTOM
}

enum AccountStageStatus {
  PENDING
  ACTIVE
  PASSED
  FAILED
  BREACHED
  RESET
  ABANDONED
  ARCHIVED
}

// One historical record per stage a PropFirmAccount has gone through.
// Advancing a stage (advanceAccountStage) closes the current PENDING/ACTIVE
// one and creates the next in the SAME transaction — a stage's performance
// fields are never overwritten once closed; a reset/failure creates a NEW
// stage row rather than mutating the old one.
model AccountStage {
  id        String          @id @default(cuid())
  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  name  String
  order Int
  type  AccountStageType

  startingBalance Decimal            @db.Decimal(14, 2)
  currentBalance  Decimal?           @db.Decimal(14, 2) // final balance once closed
  startDate       DateTime?
  completionDate  DateTime?
  status          AccountStageStatus @default(PENDING)
  profitLoss      Decimal?           @db.Decimal(14, 2)
  completionNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rules         StageRule[]
  milestones    AccountMilestone[]
  payouts       Payout[]
  executions    TradeAccountExecution[]
  ledgerEntries AccountLedgerEntry[]

  @@index([accountId, order])
  @@index([accountId, status])
}

// The rule-template catalog (section 5 of the spec). Purely a vocabulary enum
// today — CUSTOM covers anything not yet templated. The live evaluation engine
// (reads these + StageRule.evaluationMetadata) is a later phase.
enum RuleKey {
  PROFIT_TARGET
  MAX_DAILY_LOSS
  MAX_TOTAL_LOSS
  STATIC_DRAWDOWN
  INTRADAY_TRAILING_DRAWDOWN
  EOD_TRAILING_DRAWDOWN
  DRAWDOWN_BALANCE_BASED
  DRAWDOWN_EQUITY_BASED
  MIN_TRADING_DAYS
  MAX_TRADING_DAYS
  CONSISTENCY_RULE
  MAX_RISK_PER_TRADE
  MAX_RISK_PER_DAY
  MAX_OPEN_POSITIONS
  MAX_LOT_SIZE
  MAX_CONTRACT_SIZE
  NEWS_TRADING_RESTRICTION
  WEEKEND_HOLDING_RESTRICTION
  OVERNIGHT_HOLDING_RESTRICTION
  COPY_TRADING_RESTRICTION
  EA_BOT_RESTRICTION
  INACTIVITY_LIMIT
  PAYOUT_WAITING_PERIOD
  PROFIT_SPLIT
  SCALING_REQUIREMENT
  CUSTOM
}

enum RuleValueType {
  NUMERIC
  MONETARY
  PERCENTAGE
  BOOLEAN
  TEXT
}

enum RuleBreachAction {
  WARNING_ONLY
  SOFT_BREACH
  HARD_BREACH_FAIL
  HARD_BREACH_TERMINATE
  CUSTOM
}

// A configured rule instance on one stage. Exactly one of
// numericValue/booleanValue/textValue is meaningful, per `valueType` — the
// schema doesn't enforce which (kept flexible on purpose), validation does.
model StageRule {
  id      String       @id @default(cuid())
  stageId String
  stage   AccountStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  name      String
  ruleKey   RuleKey
  valueType RuleValueType

  numericValue Decimal? @db.Decimal(14, 4)
  booleanValue Boolean?
  textValue    String?

  measurementBasis  String? // e.g. "balance" | "equity" | free text
  measurementPeriod String? // e.g. "daily" | "per-trade" | "account-lifetime" | free text
  // Configurable rule-health boundaries (percent of the rule's limit
  // consumed), read by domain/prop-firms/rule-health.ts. Sensible defaults
  // (70/90/100) apply when null — see stateFromPercent.
  warningThreshold  Decimal?          @db.Decimal(14, 4) // Safe → Approaching
  criticalThreshold Decimal?          @db.Decimal(14, 4) // Approaching → Critical
  breachThreshold   Decimal?          @db.Decimal(14, 4) // Critical → Breached
  breachAction      RuleBreachAction?

  description String?
  isEnabled   Boolean @default(true)
  sortOrder   Int     @default(0)

  // Reserved for the live-evaluation engine (a later phase) — never read by
  // Phase 1 code.
  evaluationMetadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stageId, sortOrder])
}

enum MilestoneType {
  ACCOUNT_PURCHASED
  PHASE_PASSED
  PHASE_FAILED
  STAGE_RESET
  FUNDED_ACHIEVED
  PAYOUT_RECEIVED
  SCALING_MILESTONE
  ACCOUNT_BREACHED
  CUSTOM
}

// A generalized achievement/evidence record for an account (and, when
// relevant, one specific stage). Evidence FILES reuse the universal media
// system (MediaAttachment.ownerType = PROP_FIRM_MILESTONE, ownerId = this
// milestone's id) — no duplicate storage mechanism. No direct `userId`: scoped
// through `account.userId`, the same pattern TradeAccountAllocation uses via
// `trade.userId` rather than a denormalized column.
model AccountMilestone {
  id        String          @id @default(cuid())
  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stageId   String?
  stage     AccountStage?   @relation(fields: [stageId], references: [id])

  type        MilestoneType
  title       String?
  achievedAt  DateTime      @default(now())
  description String?

  createdAt DateTime @default(now())

  @@index([accountId])
  @@index([stageId])
}

enum PayoutStatus {
  AVAILABLE
  REQUESTED
  UNDER_REVIEW
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

// A payout drawn against a funded account (optionally tied to the specific
// funded stage). Certificate/payment evidence again reuses MediaAttachment
// (ownerType = PROP_FIRM_MILESTONE, ownerId = this payout's id — a payout IS
// a kind of milestone evidence target, same owner-type as AccountMilestone).
model Payout {
  id        String          @id @default(cuid())
  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stageId   String?
  stage     AccountStage?   @relation(fields: [stageId], references: [id])

  grossPayout        Decimal  @db.Decimal(14, 2)
  profitSplitPercent Decimal? @db.Decimal(5, 2)
  netExpected        Decimal? @db.Decimal(14, 2)
  netReceived        Decimal? @db.Decimal(14, 2)

  requestedDate DateTime? @db.Date
  approvedDate  DateTime? @db.Date
  paidDate      DateTime? @db.Date

  status         PayoutStatus @default(AVAILABLE)
  paymentMethod  String?
  referenceId    String?
  feesDeductions Decimal?     @db.Decimal(14, 2)
  notes          String?

  // CSV import provenance (§ Prop Firm CSV Import) — all null for a manually
  // entered payout. `sourceTransactionId` is unique: at most one confirmed
  // Payout per raw imported withdrawal transaction.
  importBatchId         String?
  importBatch           PropFirmImportBatch? @relation(fields: [importBatchId], references: [id])
  platformTransactionId String?
  sourceTransactionId   String?              @unique
  sourceTransaction     PropFirmTransaction? @relation(fields: [sourceTransactionId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountId, status])
}

// ── Account ledger (spec §5) ─────────────────────────────────────────────────
// Immutable, auditable balance history for a PropFirmAccount — aggregate
// balances/track-record are computed FROM these rows (domain/prop-firms/
// track-record.ts) rather than repeatedly overwriting a stored total.
// TRADE_PNL/PAYOUT/STAGE_*/ACCOUNT_INITIALIZED entries are system-derived and
// idempotent via the (sourceType, sourceId, eventType) unique key — an
// edit/re-import/resync upserts the SAME row instead of duplicating.
// MANUAL_ADJUSTMENT/CUSTOM_ADJUSTMENT rows have no source (sourceType/
// sourceId null) and are always plain inserts — Postgres treats NULLs as
// distinct in a unique index, so they never collide with each other,
// preserving full manual-adjustment history. `reason` is required (validated
// in account-ledger.service.ts) for MANUAL_ADJUSTMENT/CUSTOM_ADJUSTMENT.
enum LedgerEventType {
  ACCOUNT_INITIALIZED
  TRADE_PNL
  MANUAL_ADJUSTMENT
  COMMISSION_FEE
  CHALLENGE_PURCHASE_FEE
  RESET_FEE
  ACTIVATION_FEE
  OTHER_FEE
  PAYOUT
  REFUND
  DEPOSIT
  WITHDRAWAL
  CREDIT
  BALANCE_CORRECTION
  STAGE_PASSED
  STAGE_FAILED
  ACCOUNT_BREACHED
  STAGE_STARTING_BALANCE_RESET
  CUSTOM_ADJUSTMENT
}

enum LedgerSourceType {
  TRADE_EXECUTION
  PAYOUT
  STAGE_TRANSITION
  ACCOUNT_INIT
  IMPORTED_TRANSACTION
  MANUAL
}

model AccountLedgerEntry {
  id        String          @id @default(cuid())
  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  stageId   String?
  stage     AccountStage?   @relation(fields: [stageId], references: [id])

  eventType    LedgerEventType
  amount       Decimal         @db.Decimal(14, 2) // signed: + increases balance, − decreases
  balanceAfter Decimal         @db.Decimal(14, 2) // running balance snapshot, written at insert time

  occurredAt DateTime @default(now())
  reason     String? // required (enforced in service) for MANUAL_ADJUSTMENT/CUSTOM_ADJUSTMENT

  // Polymorphic source reference (no hard FK — same convention as
  // AccountMilestone/MediaAttachment's ownerId), e.g. sourceType=
  // TRADE_EXECUTION, sourceId=TradeAccountExecution.id. Drives idempotent
  // upserts via the unique index below.
  sourceType LedgerSourceType?
  sourceId   String?

  createdAt DateTime @default(now())

  @@unique([sourceType, sourceId, eventType])
  @@index([accountId, occurredAt])
  @@index([stageId])
}

// ── TradingView Screenshot Trade Plan ────────────────────────────────────────
// Lets a trader upload a TradingView chart screenshot as the visual source of
// a Trade Idea's PLANNED execution (direction/entry/stop/targets/R:R) — never
// the actual execution (Trade.actualEntry/actualExit and TradeAccountExecution
// stay exactly as they are, entered separately). Additive: nothing on Trade's
// existing plannedEntry/plannedStopLoss/plannedTarget columns is removed —
// those stay as the simple single-target legacy fields (kept in sync with
// PlannedTarget #1 on confirm, for every existing reader of them); this model
// group is the richer multi-target, screenshot-backed source of truth for
// trades planned through this feature.
//
// One screenshot per trade (TradePlanScreenshot.tradeId is unique) —
// "replacing the screenshot before confirmation" mutates this same row's file
// reference and resets its recognition state rather than creating a new row.
// The trader can also point a fresh Trade Idea at an image already uploaded
// as a before-trade attachment (spec: "select an already uploaded before-
// trade screenshot") — same underlying MediaAsset, wrapped by this row.
//
// Recognition is provider-agnostic (see domain/trade-plan/recognition.ts) and
// OPTIONAL: with no vision provider configured, every screenshot resolves
// straight to MANUALLY_CONFIGURED and the trader annotates by hand — the
// recognition failure path is a first-class, always-exercised state, not an
// edge case.
enum ScreenshotPlanStatus {
  UPLOADED
  QUEUED
  PROCESSING
  RECOGNITION_COMPLETE
  NEEDS_CONFIRMATION
  CONFIRMED
  RECOGNITION_FAILED
  MANUALLY_CONFIGURED
  LOCKED
}

enum AssetClass {
  FOREX
  METALS
  INDEX
  FUTURES
  CRYPTO
  STOCK
  OTHER
}

// The unit a planned distance/annotation is expressed in — deliberately NOT
// forced to pips for every instrument (spec §6/§17: "do not combine pips,
// points and ticks into a misleading universal average").
enum DistanceUnit {
  PIP
  POINT
  TICK
  PRICE
  PERCENT
}

model TradePlanScreenshot {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tradeId String @unique
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // The uploaded chart image (reuses the universal media system — see
  // MediaAsset's planScreenshotOriginalOf/planScreenshotPreviewOf). previewMediaAssetId
  // is an OPTIONAL separately-rendered image with the confirmed annotations
  // burned in for quick sharing/review — the original above is never
  // overwritten, per spec §8 ("do not permanently draw annotations onto the
  // only copy of the screenshot").
  mediaAssetId        String      @unique
  mediaAsset          MediaAsset  @relation("TradePlanScreenshotOriginal", fields: [mediaAssetId], references: [id])
  previewMediaAssetId String?     @unique
  previewMediaAsset   MediaAsset? @relation("TradePlanScreenshotPreview", fields: [previewMediaAssetId], references: [id])

  width  Int?
  height Int?

  status              ScreenshotPlanStatus @default(UPLOADED)
  recognitionProvider String? // e.g. "anthropic-vision" — null when no provider ran (manual path)
  recognitionVersion  String? // provider/prompt/model version, for reproducibility of past results
  recognitionError    String? // trader-facing reason when status = RECOGNITION_FAILED

  // Best-effort top-line detections, denormalized here for quick display
  // (the full per-field detail — confidence, bounding box, raw text — lives
  // in ScreenshotRecognitionField below, one row per detected field).
  detectedSymbol            String?
  canonicalInstrumentSymbol String? // resolved via domain/trade-plan/instrument-catalog.ts
  detectedTimeframe         String?
  detectedDirection         Direction?
  recognitionMetadata       Json? // raw provider response, for debugging/re-processing — never logged verbatim (see privacy notes)

  uploadedAt  DateTime  @default(now())
  processedAt DateTime?
  confirmedAt DateTime?
  lockedAt    DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  recognitionFields ScreenshotRecognitionField[]
  annotations       TradePlanAnnotation[]

  @@index([userId, tradeId])
  @@index([status])
}

// What a screenshot annotation/plan field represents — mirrors the Trade
// Idea's own planned vocabulary so a detected field maps 1:1 onto a plan input.
enum RecognitionFieldType {
  SYMBOL
  ASSET_CLASS
  TIMEFRAME
  DIRECTION
  ENTRY
  STOP_LOSS
  TARGET
  RISK_REWARD
  STOP_DISTANCE
  TARGET_DISTANCE
  CHART_TIMESTAMP
}

enum RecognitionSource {
  AI_VISION
  OCR
  MANUAL
}

enum RecognitionConfirmationStatus {
  PENDING
  ACCEPTED
  CORRECTED
  REJECTED
}

// One row per detected (or manually-entered-in-its-place) field on a
// screenshot — the structured result the spec requires instead of
// unstructured text, each with its own confidence/bounding box/raw text so
// the confirmation screen can render "Detected from screenshot · High
// confidence" per field rather than one blended verdict for the whole image.
model ScreenshotRecognitionField {
  id           String              @id @default(cuid())
  screenshotId String
  screenshot   TradePlanScreenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)

  fieldType         RecognitionFieldType
  targetOrder       Int? // disambiguates TARGET rows (TP1/TP2/TP3/…) when fieldType = TARGET
  rawExtractedText  String?
  detectedValue     String? // stored as text — a price, a symbol, "LONG", "15m", etc.; parsed by the caller per fieldType
  confidence        Float? // 0–1, null when not provided by the recognition source
  boundingBox       Json? // { x, y, width, height } normalized 0–1 within the image, when available
  recognitionSource RecognitionSource    @default(MANUAL)
  warning           String? // e.g. "Overlapping price labels — low confidence"

  confirmationStatus RecognitionConfirmationStatus @default(PENDING)
  confirmedValue     String? // what the trader actually accepted/corrected it to
  confirmedByUserId  String?
  confirmedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([screenshotId, fieldType])
}

// A horizontal (or point-to-point) level drawn on the screenshot — entry,
// stop, a target, or a free-form level. Coordinates are NORMALIZED (0–1) so
// they stay aligned regardless of how large the image renders; per spec §7,
// the `confirmedPrice` — never the pixel position — is the source of truth
// for every calculation. A dragged line only ever updates its own
// coordinates, not confirmedPrice, unless the trader also edits the price.
enum AnnotationType {
  ENTRY
  STOP_LOSS
  TARGET
  INVALIDATION
  BREAK_EVEN
  CUSTOM
}

enum AnnotationSource {
  DETECTED
  MANUAL
}

model TradePlanAnnotation {
  id           String              @id @default(cuid())
  screenshotId String
  screenshot   TradePlanScreenshot @relation(fields: [screenshotId], references: [id], onDelete: Cascade)

  type  AnnotationType
  label String // e.g. "Entry", "TP2", or a custom name the trader gave it

  confirmedPrice Decimal? @db.Decimal(18, 8) // null until the trader confirms/enters a price for this line

  // Normalized 0–1 coordinates within the screenshot. A simple horizontal
  // line only needs y; startX/endX/endY support a non-horizontal or
  // point-to-point annotation (e.g. a trend-aligned stop) when the trader
  // draws one.
  y      Float
  startX Float?
  endX   Float?
  endY   Float?

  color   String // semantic hex/token — see domain/trade-plan/annotation-colors.ts
  visible Boolean @default(true)

  targetOrder Int? // ordering among TARGET-type annotations (TP1 = 1, TP2 = 2, …)
  confidence  Float? // carried over from the recognition field that produced this, when DETECTED
  source      AnnotationSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([screenshotId, type])
}

// A single planned profit target on a Trade Idea — the live, editable set.
// Trade.plannedTarget (the original single-target column) is kept in sync
// with target #1 on every confirm, so existing readers of that field (older
// trades, other UI) keep working unchanged; PlannedTarget[] is the richer
// source of truth for anything built against this feature.
model PlannedTarget {
  id      String @id @default(cuid())
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  targetOrder Int // 1 = TP1, 2 = TP2, …
  label       String // defaults to "TP{targetOrder}", renameable

  targetPrice Decimal @db.Decimal(18, 8)

  // Frozen at confirm time from domain/trade-plan/distance.ts — never
  // recomputed from a later-edited instrument catalog entry.
  unitDistance Decimal?      @db.Decimal(18, 8)
  unitType     DistanceUnit?
  rMultiple    Decimal?      @db.Decimal(8, 4)

  plannedClosePercent   Decimal? @db.Decimal(5, 2) // 0–100; null/unset = trader hasn't planned a partial split
  managementInstruction String? // free text, e.g. "Move stop to break-even after this fills"
  moveToBreakEven       Boolean  @default(false)
  notes                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  actualPartialExits TradeActualPartialExit[]

  @@unique([tradeId, targetOrder])
}

// An append-only, immutable snapshot of the confirmed plan — one row created
// on first confirmation (version 1) and one more each time a LOCKED plan is
// edited (spec §13: "create a new revision, preserve the previous version,
// require an edit reason"). Never updated after creation.
model TradePlanVersion {
  id      String @id @default(cuid())
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  versionNumber Int

  // The exact MediaAsset in effect at this version, if any — MediaAsset rows
  // are never deleted by the trade-plan replace flow (only the
  // TradePlanScreenshot *wrapper* row is), so this stays resolvable forever,
  // even after the live screenshot is later replaced. This is what makes a
  // version's screenshot immutable without needing a separate versioned
  // screenshot table (spec checkpoint 2 §2).
  screenshotMediaAssetId String?

  assetSymbol String?
  direction   Direction?
  timeframe   String?

  entry               Decimal? @db.Decimal(18, 8)
  stopLoss            Decimal? @db.Decimal(18, 8)
  // Frozen copy of every target at this version — [{ targetOrder, label,
  // targetPrice, unitDistance, unitType, rMultiple, plannedClosePercent }].
  // Json (not a relation) because a version must never change even if the
  // live PlannedTarget rows are later edited or deleted.
  targetsSnapshot     Json?
  // Frozen copy of every TradePlanAnnotation visible on the screenshot at
  // save time — [{ type, label, confirmedPrice, y, startX, endX, endY,
  // color, targetOrder, source }]. Replacing the screenshot later deletes
  // the live TradePlanAnnotation rows (they belong to that screenshot
  // wrapper), so without this snapshot a historical version would lose its
  // original annotations the moment the screenshot was replaced — this is
  // the fix for exactly that gap (checkpoint 2 §2).
  annotationsSnapshot Json?

  stopDistance     Decimal?      @db.Decimal(18, 8)
  stopDistanceUnit DistanceUnit?
  weightedPlannedR Decimal?      @db.Decimal(8, 4)

  editReason      String? // required by the service for every version after #1
  createdByUserId String
  locked          Boolean @default(false)

  createdAt DateTime @default(now())

  performanceRiskSnapshots PerformanceRiskSnapshot[]

  @@unique([tradeId, versionNumber])
  @@index([tradeId])
}

// ── Actual partial exits (checkpoint 2 §13) ──────────────────────────────────
// The structured, normalized record of what actually closed and when —
// sibling to PlannedTarget (the plan side), never conflated with it. A
// partial's `plannedTargetId` is the trader's (or an unambiguous automatic)
// mapping to a specific planned target, never assumed from exit order alone
// (spec: "do not assume that an actual partial corresponds to TP1 merely
// because it is the first recorded exit" — see domain/trade-plan/
// partial-matching.ts).
enum PartialExitSource {
  CONFIRMED
  MANUAL
  IMPORTED
}

model TradeActualPartialExit {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  tradeId String
  trade   Trade  @relation(fields: [tradeId], references: [id], onDelete: Cascade)

  // Optional — set when this trade has multiple Prop Firms account
  // allocations and this partial belongs to one specific account's
  // execution rather than the trade's own base actualEntry/actualExit.
  accountExecutionId String?
  accountExecution   TradeAccountExecution? @relation(fields: [accountExecutionId], references: [id], onDelete: SetNull)

  plannedTargetId String?
  plannedTarget   PlannedTarget? @relation(fields: [plannedTargetId], references: [id], onDelete: SetNull)

  exitOrder      Int
  exitPrice      Decimal  @db.Decimal(18, 8)
  percentClosed  Decimal? @db.Decimal(5, 2) // 0–100
  quantityClosed Decimal? @db.Decimal(14, 4) // lots/contracts/units, when tracked instead of/alongside percent
  exitedAt       DateTime

  grossPnl  Decimal? @db.Decimal(14, 2)
  fees      Decimal? @db.Decimal(14, 2)
  netPnl    Decimal? @db.Decimal(14, 2)
  realizedR Decimal? @db.Decimal(8, 4)

  notes  String?
  source PartialExitSource @default(MANUAL)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tradeId, exitOrder])
  @@index([tradeId])
  @@index([accountExecutionId])
  @@index([plannedTargetId])
}

// ── Prop Firm CSV Import (Phase 1: Generic CSV, MT4, MT5) ───────────────────
// Entirely separate from the Journal / global Trade model. Imported data only
// ever creates PropFirmImportedExecution/PropFirmImportedTrade/
// PropFirmTransaction rows, plus — for a confirmed withdrawal — an ordinary
// Payout row (extended below with import provenance columns). Balance/equity
// effects are posted to the account's own AccountLedgerEntry the exact same
// way manual TradeAccountExecution fills and Payout PAID-transitions already
// are (postLedgerEntry, account-ledger.service.ts) — nothing here ever
// creates, updates, or reads a Trade, TradeAccountExecution, or
// PerformanceRiskSnapshot row.

enum PropFirmImportPlatform {
  MT4
  MT5
  CTRADER
  NINJATRADER
  TRADOVATE
  GENERIC_CSV
}

enum PropFirmImportFileFormat {
  CSV
  TSV
  TXT
  XLSX
  XLS
  HTML
  XML
}

enum PropFirmImportBatchStatus {
  CONFIRMED
  ROLLED_BACK
}

enum PropFirmTransactionClassification {
  DEPOSIT
  WITHDRAWAL_PAYOUT
  WITHDRAWAL_UNCLASSIFIED
  INTERNAL_TRANSFER
  ACCOUNT_RESET
  FEE
  COMMISSION
  REFUND
  BALANCE_CORRECTION
  CREDIT
  UNKNOWN
}

enum PropFirmImportedTradeStatus {
  OPEN
  PARTIAL
  CLOSED
}

// One row per confirmed upload. Written only inside confirmImport's single
// transaction alongside everything it produced, so a failed/cancelled import
// never leaves an orphaned batch row.
model PropFirmImportBatch {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  platform      PropFirmImportPlatform
  fileFormat    PropFirmImportFileFormat
  fileName      String
  fileSizeBytes Int
  // Browser-reported MIME type of the upload (may be empty/generic) + the
  // worksheet / HTML table / statement section the rows were taken from —
  // both kept for audit.
  sourceMimeType   String?
  sheetOrTableName String?
  timezone      String // IANA zone, user-confirmed before parsing

  status PropFirmImportBatchStatus @default(CONFIRMED)

  dateRangeFrom DateTime?
  dateRangeTo   DateTime?

  newExecutionsCount     Int   @default(0)
  newTradesCount         Int   @default(0)
  newPayoutsCount        Int   @default(0)
  skippedDuplicatesCount Int   @default(0)
  rejectedRowsCount      Int   @default(0)
  warnings               Json?

  mappingTemplateId String?
  mappingTemplate   PropFirmImportMappingTemplate? @relation(fields: [mappingTemplateId], references: [id])

  createdAt    DateTime  @default(now())
  rolledBackAt DateTime?

  executions   PropFirmImportedExecution[]
  transactions PropFirmTransaction[]
  payouts      Payout[]

  @@index([accountId, createdAt])
}

// One row per platform execution/deal/fill, after adapter normalization —
// preserved verbatim (rawRow) for audit even after trade reconstruction
// groups it into a PropFirmImportedTrade. `dedupeKey` is always populated
// (platform id when available, else a normalized fingerprint) and is the
// sole idempotency guard, backed by the unique index below.
model PropFirmImportedExecution {
  id String @id @default(cuid())

  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  importBatchId String
  importBatch   PropFirmImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  platform            PropFirmImportPlatform
  platformExecutionId String?
  platformOrderId     String?
  platformDealId      String?

  instrumentRaw        String
  instrumentNormalized String
  direction            Direction

  quantity Decimal @db.Decimal(14, 4)
  price    Decimal @db.Decimal(18, 8)

  grossPnl   Decimal? @db.Decimal(14, 2)
  commission Decimal? @db.Decimal(14, 2)
  swap       Decimal? @db.Decimal(14, 2)
  otherFees  Decimal? @db.Decimal(14, 2)
  currency   String?

  executedAt DateTime
  dedupeKey  String
  rawRow     Json

  reconstructedTradeId String?
  reconstructedTrade   PropFirmImportedTrade? @relation(fields: [reconstructedTradeId], references: [id])

  createdAt DateTime @default(now())

  @@unique([accountId, dedupeKey])
  @@index([importBatchId])
  @@index([reconstructedTradeId])
}

// A reconstructed logical round-trip trade — derived, never hand-edited.
// Recomputed wholesale from an account's surviving PropFirmImportedExecution
// rows on every confirm/rollback (prop-firm-import.service.ts) rather than
// patched in place, so it's always exactly consistent with its executions.
model PropFirmImportedTrade {
  id String @id @default(cuid())

  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  instrument String
  direction  Direction
  status     PropFirmImportedTradeStatus

  openedAt DateTime
  closedAt DateTime?

  entryCount Int
  exitCount  Int

  totalQuantity Decimal  @db.Decimal(14, 4)
  avgEntryPrice Decimal  @db.Decimal(18, 8)
  avgExitPrice  Decimal? @db.Decimal(18, 8)

  grossPnl   Decimal @db.Decimal(14, 2)
  commission Decimal @db.Decimal(14, 2)
  swap       Decimal @db.Decimal(14, 2)
  otherFees  Decimal @db.Decimal(14, 2)
  netPnl     Decimal @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions PropFirmImportedExecution[]

  @@index([accountId])
}

// A non-trade financial event from an imported statement — deposits,
// withdrawals (payout candidates), fees, credits, unknown adjustments.
// `classification` starts as the adapter/classifier's best guess;
// `requiresReview` gates anything under-confidence until the user confirms
// it in the import preview. A confirmed WITHDRAWAL_PAYOUT gets exactly one
// linked Payout row via Payout.sourceTransactionId (unique).
model PropFirmTransaction {
  id String @id @default(cuid())

  accountId String
  account   PropFirmAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  importBatchId String
  importBatch   PropFirmImportBatch @relation(fields: [importBatchId], references: [id], onDelete: Cascade)

  platform              PropFirmImportPlatform
  platformTransactionId String?
  rawType               String
  classification        PropFirmTransactionClassification

  amount   Decimal @db.Decimal(14, 2)
  currency String?

  occurredAt DateTime
  dedupeKey  String
  rawRow     Json

  requiresReview Boolean   @default(false)
  reviewedAt     DateTime?

  createdAt DateTime @default(now())

  payout Payout?

  @@unique([accountId, dedupeKey])
  @@index([importBatchId])
}

// A reusable column-mapping for Generic CSV (and manually-remapped platform
// CSVs) — saved so a recurring broker/format doesn't need re-mapping on
// every upload.
model PropFirmImportMappingTemplate {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name          String
  platform      PropFirmImportPlatform
  columnMapping Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batches PropFirmImportBatch[]

  @@unique([userId, name])
}
