DATABASE_URL="postgresql://user:password@localhost:5432/trading_hub?schema=public"

AUTH_SECRET=

# Cloudflare R2 (image / media storage). Uploads are disabled until all four are set.
# Account ID: Cloudflare dashboard → R2 → Overview (also in the S3 API endpoint).
# Access keys: R2 → Manage R2 API Tokens → Create API Token (Object Read & Write).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Databento (Stage 17B) — CME/CBOT/NYMEX/COMEX futures historical market
# data for Replay (GC/ES/NQ and their MGC/MES/MNQ aliases). Server-side
# only — NEVER prefix with NEXT_PUBLIC_. Absent = Replay silently falls
# back to FixtureMarketDataProvider (synthetic, dev-only) for these assets;
# nothing breaks without it.
DATABENTO_API_KEY=

# Licensing guard (Stage 17B §16/§20) — MUST stay unset/"false" until
# Databento's redistribution/display terms are explicitly confirmed for
# showing real market data to end users. Even with DATABENTO_API_KEY set,
# Replay stays on the Fixture provider for real users while this is off.
MARKET_DATA_EXTERNAL_DISPLAY_ENABLED=false

# Durable R2 cache for real (Databento) candle data (Stage 17B §21) —
# opt-in, defaults off pending the same licensing confirmation as above.
# Requires the R2_* vars above to also be set.
DATABENTO_R2_CACHE_ENABLED=false

# Twelve Data (Stage 17C.2) — Forex/spot-metals historical MID (mid-market
# aggregate, NOT broker-exact) market data for Replay (EURUSD, GBPUSD,
# USDJPY, XAUUSD, XAGUSD). Server-side only — NEVER prefix with
# NEXT_PUBLIC_. Absent = Replay silently falls back to
# FixtureMarketDataProvider (synthetic, dev-only) for these assets; nothing
# breaks without it.
TWELVE_DATA_API_KEY=

# Licensing guard (Stage 17C.2 §6) — Twelve Data's OWN, independent flag;
# it does NOT share MARKET_DATA_EXTERNAL_DISPLAY_ENABLED above, because
# Databento and Twelve Data are separate vendors under separate commercial
# agreements. MUST stay unset/"false" until a Twelve Data commercial plan
# with confirmed external-display rights (Venture tier or above — see
# docs/TWELVE_DATA_MARKET_DATA.md) is actually in place. Even with
# TWELVE_DATA_API_KEY set, Replay stays on Fixture for real users while
# this is off.
TWELVE_DATA_EXTERNAL_DISPLAY_ENABLED=false

# Durable R2 cache for real (Twelve Data) candle data (Stage 17C.2 §22-25) —
# opt-in, defaults off. Twelve Data's license ties caching rights to the
# ACTIVE SUBSCRIPTION and requires deletion within 30 days of termination —
# see docs/TWELVE_DATA_MARKET_DATA.md's "Subscription lifecycle" section
# and `scripts/purge-twelvedata-market-data-cache.mjs` before ever
# terminating a subscription with this enabled. Requires the R2_* vars
# above to also be set.
TWELVE_DATA_R2_CACHE_ENABLED=false

# Shared, non-production-only escape hatch (Stage 17B.1 §10, reused Stage
# 17C.2 §6) — lets a developer exercise EITHER the Databento or Twelve Data
# path locally without flipping the production-facing licensing flags
# above. Requires NODE_ENV != "production" to ever take effect, so it can
# never be accidentally left on in a deployed environment.
MARKET_DATA_EXTERNAL_DISPLAY_DEV_OVERRIDE=false

# Anthropic (Claude) — used by the Trade Plan screenshot-recognition
# vision provider AND, since Stage 20, the Traditorium Review Analyst
# (Edge -> Analyst tab). Server-side only — NEVER prefix with
# NEXT_PUBLIC_. Absent = screenshot recognition falls back to manual entry
# and the Analyst tab shows "AI analysis unavailable"; nothing else breaks
# without it.
ANTHROPIC_API_KEY=
